#!/usr/bin/env bash
# bin/openapi-generate
#
# Generates the azure_rest Ruby gem API and model classes from the official
# Azure REST API OpenAPI specs hosted at:
#   https://github.com/Azure/azure-rest-api-specs
#
# Each ARM namespace is generated into its own subdirectory:
#   lib/azure_rest/{namespace}/api/
#   lib/azure_rest/{namespace}/models/
#
# Shared scaffolding (ApiClient, Configuration, ApiError) is written once
# from the Resources spec and then protected by .openapi-generator-ignore.
#
# Usage:
#   bin/openapi-generate                              # auto-download latest generator
#   OPENAPI_GENERATOR_JAR=path/to.jar bin/openapi-generate
#
# Environment variables:
#   GITHUB_TOKEN           GitHub PAT (required for >60 API req/hr)
#   OPENAPI_GENERATOR_JAR  Path to an existing generator JAR (skips download)
#   CI                     Set automatically by GitHub Actions; disables colour
#
# Requirements: java, wget, xq

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(dirname "${SCRIPT_DIR}")"
cd "${REPO_ROOT}"

# ── Colour output (disabled in CI) ────────────────────────────────────────────
if [ -t 1 ] && [ -z "${CI:-}" ]; then
  RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; NC=''
fi
info()    { echo -e "${CYAN}[generate]${NC} $*"; }
success() { echo -e "${GREEN}[generate]${NC} $*"; }
warn()    { echo -e "${YELLOW}[generate]${NC} $*"; }
error()   { echo -e "${RED}[generate]${NC} $*" >&2; exit 1; }

# ── Dependency checks ─────────────────────────────────────────────────────────
command -v java >/dev/null 2>&1 || error "java is required but not installed"
if command -v curl >/dev/null 2>&1; then
  DOWNLOADER="curl"
elif command -v wget >/dev/null 2>&1; then
  DOWNLOADER="wget"
else
  error "curl or wget is required but neither is installed"
fi

fetch() {
  if [ "$DOWNLOADER" = "curl" ]; then
    curl --silent --location --fail "$1"
  else
    wget "$1" -O - 2>/dev/null
  fi
}

download() {
  if [ "$DOWNLOADER" = "curl" ]; then
    curl --silent --location --fail "$1" -o "$2"
  else
    wget "$1" -O "$2"
  fi
}

# ── Locate or download the generator JAR ─────────────────────────────────────
if [ -z "${OPENAPI_GENERATOR_JAR:-}" ]; then
  info "Fetching latest openapi-generator-cli version from Maven Central..."
  MAVEN_META="https://repo1.maven.org/maven2/org/openapitools/openapi-generator-cli/maven-metadata.xml"
  LATEST_VERSION=$(fetch "$MAVEN_META" | grep -o '<latest>[^<]*</latest>' | sed 's/<[^>]*>//g' || true)
  [ -n "$LATEST_VERSION" ] || error "Could not determine latest openapi-generator-cli version"

  OPENAPI_GENERATOR_JAR="${REPO_ROOT}/openapi-generator-cli-${LATEST_VERSION}.jar"

  if [ ! -f "$OPENAPI_GENERATOR_JAR" ]; then
    info "Downloading openapi-generator-cli ${LATEST_VERSION}..."
    download \
      "https://repo1.maven.org/maven2/org/openapitools/openapi-generator-cli/${LATEST_VERSION}/openapi-generator-cli-${LATEST_VERSION}.jar" \
      "$OPENAPI_GENERATOR_JAR"
    success "Downloaded to ${OPENAPI_GENERATOR_JAR}"
  else
    info "Using cached ${OPENAPI_GENERATOR_JAR}"
  fi
fi

[ -f "$OPENAPI_GENERATOR_JAR" ] || error "JAR not found: ${OPENAPI_GENERATOR_JAR}"

JAR="$OPENAPI_GENERATOR_JAR"
CFG="${REPO_ROOT}/.openapi-config.json"

# ── Resolve latest stable spec URL for a given provider path ─────────────────
# Usage: resolve_spec <provider_path> <preferred_filename>
# Walks provider_path/stable/, picks the latest version dir, returns raw URL.
# Exits non-zero on failure (triggers warn+skip in gen()).
resolve_spec() {
  local stable_path="$1"
  local preferred="$2"

  python3 << PYEOF
import urllib.request, json, sys, os

base_api = "https://api.github.com/repos/Azure/azure-rest-api-specs/contents/specification"
base_raw = "https://raw.githubusercontent.com/Azure/azure-rest-api-specs/main/specification"
stable_path = "${stable_path}"
preferred = "${preferred}"

token = os.environ.get("GITHUB_TOKEN", "")
headers = {"User-Agent": "azure-rest-generate/1.0"}
if token:
    headers["Authorization"] = "token " + token

def fetch(url):
    req = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(req, timeout=15) as r:
        return json.loads(r.read())

try:
    items = fetch(f"{base_api}/{stable_path}")
    has_stable = any(i["name"] == "stable" and i["type"] == "dir" for i in items)
    if has_stable:
        version_items = fetch(f"{base_api}/{stable_path}/stable")
        versions = sorted([i["name"] for i in version_items if i["type"] == "dir"], reverse=True)
        for v in versions:
            files = fetch(f"{base_api}/{stable_path}/stable/{v}")
            jsons = [f["name"] for f in files if f["name"].endswith(".json") and f["type"] == "file"]
            if not jsons:
                continue
            chosen = preferred if preferred in jsons else jsons[0]
            print(f"{base_raw}/{stable_path}/stable/{v}/{chosen}")
            sys.exit(0)
    print("ERROR: no stable version found", file=sys.stderr)
    sys.exit(1)
except Exception as e:
    print(f"ERROR: {e}", file=sys.stderr)
    sys.exit(1)
PYEOF
}

# ── Helper: CamelCase namespace -> snake_case dir name ────────────────────────
to_snake() {
  case "$1" in
    Compute)          echo "compute" ;;
    Network)          echo "network" ;;
    Resources)        echo "resources" ;;
    Storage)          echo "storage" ;;
    KeyVault)         echo "key_vault" ;;
    ContainerService) echo "container_service" ;;
    Sql)              echo "sql" ;;
    MariaDB)          echo "maria_db" ;;
    MySQL)            echo "my_sql" ;;
    PostgreSQL)       echo "postgre_sql" ;;
    Authorization)    echo "authorization" ;;
    Insights)         echo "insights" ;;
    HDInsight)        echo "hd_insight" ;;
    Commerce)         echo "commerce" ;;
    *)                echo "$1" | tr '[:upper:]' '[:lower:]' ;;
  esac
}

# ── Helper: move new files from flat dirs into namespace subdir ───────────────
# Rewrites "module AzureRest" -> "module AzureRest\n  module <Namespace>" and
# closes the extra module at the end of each file.
move_new_files() {
  local before="$1" after="$2" dest="$3" ns="$4"
  comm -13 <(echo "$before" | sort) <(echo "$after" | sort) \
  | while IFS= read -r f; do
    [ -f "$f" ] || continue
    python3 - "$f" "$ns" << 'PYEOF'
import sys
path, ns = sys.argv[1], sys.argv[2]
with open(path) as fh:
    src = fh.read()
src = src.replace("module AzureRest\n", "module AzureRest\n  module " + ns + "\n", 1)
idx = src.rfind("\nend")
if idx != -1:
    src = src[:idx] + "\n  end\nend"
with open(path, 'w') as fh:
    fh.write(src)
PYEOF
    mv "$f" "$dest/"
  done
}

# ── Helper: move new files from flat dirs into namespace subdir (no rewrite) ──
# Used for docs/ and spec/ files which are not Ruby modules.
move_new_files_plain() {
  local before="$1" after="$2" dest="$3"
  comm -13 <(echo "$before" | sort) <(echo "$after" | sort) \
  | while IFS= read -r f; do
    [ -f "$f" ] || continue
    mv "$f" "$dest/"
  done
}

# ── Per-namespace generation ──────────────────────────────────────────────────
# Usage: gen <RubyNamespace> <provider_path> <preferred_file>
#        gen <RubyNamespace> --url <full_spec_url>
#
# Resolves the spec URL (or uses the one provided), runs the generator, then
# moves new files from the flat output dirs into scoped namespace subdirs.
gen() {
  local namespace="$1"
  local ns_lower
  ns_lower=$(to_snake "$namespace")

  local spec_url
  if [ "${2:-}" = "--url" ]; then
    spec_url="$3"
    info "Generating ${namespace} (pinned spec)..."
  else
    local stable_path="$2"
    local preferred="$3"
    info "Resolving ${namespace} spec..."
    spec_url=$(resolve_spec "$stable_path" "$preferred") || {
      warn "Could not resolve ${namespace} spec — skipping"
      return 0
    }
    info "${namespace} spec: ${spec_url}"
    info "Generating ${namespace}..."
  fi

  # Snapshot existing flat files before generation
  local before_api before_models before_docs before_spec_api before_spec_models
  before_api=$(find "${REPO_ROOT}/lib/azure_rest/api"    -name "*.rb"  2>/dev/null | sort || true)
  before_models=$(find "${REPO_ROOT}/lib/azure_rest/models" -name "*.rb"  2>/dev/null | sort || true)
  before_docs=$(find "${REPO_ROOT}/docs"                 -name "*.md"  2>/dev/null | sort || true)
  before_spec_api=$(find "${REPO_ROOT}/spec/api"         -name "*_spec.rb" 2>/dev/null | sort || true)
  before_spec_models=$(find "${REPO_ROOT}/spec/models"   -name "*_spec.rb" 2>/dev/null | sort || true)

  java -jar "$JAR" generate \
    --input-spec        "$spec_url" \
    --generator-name    ruby \
    --config            "$CFG" \
    --skip-validate-spec \
    --output            "${REPO_ROOT}" \
    2>&1 | grep -v "^$" | grep -v "^\[main\]" || true

  # Move new files into scoped namespace dirs
  local dest_api="${REPO_ROOT}/lib/azure_rest/${ns_lower}/api"
  local dest_models="${REPO_ROOT}/lib/azure_rest/${ns_lower}/models"
  local dest_docs="${REPO_ROOT}/docs/${ns_lower}"
  local dest_spec_api="${REPO_ROOT}/spec/api/${ns_lower}"
  local dest_spec_models="${REPO_ROOT}/spec/models/${ns_lower}"
  mkdir -p "$dest_api" "$dest_models" "$dest_docs" "$dest_spec_api" "$dest_spec_models"

  local after_api after_models after_docs after_spec_api after_spec_models
  after_api=$(find "${REPO_ROOT}/lib/azure_rest/api"    -name "*.rb"  2>/dev/null | sort || true)
  after_models=$(find "${REPO_ROOT}/lib/azure_rest/models" -name "*.rb"  2>/dev/null | sort || true)
  after_docs=$(find "${REPO_ROOT}/docs"                 -name "*.md"  2>/dev/null | sort || true)
  after_spec_api=$(find "${REPO_ROOT}/spec/api"         -name "*_spec.rb" 2>/dev/null | sort || true)
  after_spec_models=$(find "${REPO_ROOT}/spec/models"   -name "*_spec.rb" 2>/dev/null | sort || true)

  move_new_files       "$before_api"         "$after_api"         "$dest_api"         "$namespace"
  move_new_files       "$before_models"      "$after_models"      "$dest_models"      "$namespace"
  move_new_files_plain "$before_docs"        "$after_docs"        "$dest_docs"
  move_new_files_plain "$before_spec_api"    "$after_spec_api"    "$dest_spec_api"
  move_new_files_plain "$before_spec_models" "$after_spec_models" "$dest_spec_models"

  # Generate per-namespace loader file: lib/azure_rest/<ns_lower>.rb
  local loader="${REPO_ROOT}/lib/azure_rest/${ns_lower}.rb"
  {
    echo "# frozen_string_literal: true"
    echo ""
    echo "module AzureRest"
    echo "  module ${namespace}"
    { find "$dest_models" -name "*.rb" 2>/dev/null | sort; find "$dest_api" -name "*.rb" 2>/dev/null | sort; } | while IFS= read -r f; do
      [ -f "$f" ] || continue
      local const
      const=$(python3 - "$f" << 'PYEOF'
import sys, re
with open(sys.argv[1]) as fh:
    for line in fh:
        m = re.match(r'^\s*class\s+([A-Za-z0-9_]+)', line)
        if m and m.group(1) != "EnumAttributeValidator" and m.group(1)[0].isupper():
            print(m.group(1))
            break
PYEOF
      )
      if [ -n "$const" ]; then
        echo "    autoload :${const}, \"${f#${REPO_ROOT}/lib/}\""
      fi
    done
    echo "  end"
    echo "end"
  } > "$loader"

  success "${namespace} done (-> lib/azure_rest/${ns_lower}/, docs/${ns_lower}/, spec/*/${ns_lower}/)"
}

# ── Wipe all previously generated directories ─────────────────────────────────
info "Clearing previously generated files..."
for ns in compute network resources storage key_vault container_service \
           sql maria_db my_sql postgre_sql authorization insights hd_insight commerce; do
  rm -rf "${REPO_ROOT}/lib/azure_rest/${ns}/api"
  rm -rf "${REPO_ROOT}/lib/azure_rest/${ns}/models"
  rm -rf "${REPO_ROOT}/docs/${ns}"
  rm -rf "${REPO_ROOT}/spec/api/${ns}"
  rm -rf "${REPO_ROOT}/spec/models/${ns}"
done
rm -rf "${REPO_ROOT}/lib/azure_rest/api"
rm -rf "${REPO_ROOT}/lib/azure_rest/models"
rm -rf "${REPO_ROOT}/docs"
rm -rf "${REPO_ROOT}/spec/api"
rm -rf "${REPO_ROOT}/spec/models"

# ── Generate shared scaffolding once ──────────────────────────────────────────
# Writes: configuration.rb, api_client.rb, api_error.rb, version.rb
# These are protected by .openapi-generator-ignore on subsequent runs.
info "Resolving Resources spec URL..."
RESOURCES_SPEC=$(resolve_spec \
  "resources/resource-manager/Microsoft.Resources/resources" \
  "resources.json") \
  || error "Could not resolve Resources spec"
info "Resources spec: ${RESOURCES_SPEC}"

info "Generating shared scaffolding from Resources spec..."
java -jar "$JAR" generate \
  --input-spec        "$RESOURCES_SPEC" \
  --generator-name    ruby \
  --config            "$CFG" \
  --global-property   "supportingFiles,apiDocs=false,modelDocs=false,apis=false,models=false" \
  --skip-validate-spec \
  --output            "${REPO_ROOT}" \
  2>&1 | grep -v "^$" | grep -v "^\[main\]" || true
success "Shared scaffolding written"

# ── Generate each ARM namespace ───────────────────────────────────────────────
gen "Compute" \
  "compute/resource-manager/Microsoft.Compute/Compute" \
  "ComputeRP.json"

gen "Network" \
  "network/resource-manager/Microsoft.Network/Network" \
  "virtualNetwork.json"

gen "Resources" \
  "resources/resource-manager/Microsoft.Resources/resources" \
  "resources.json"

gen "Storage" \
  "storage/resource-manager/Microsoft.Storage" \
  "openapi.json"

gen "KeyVault" \
  "keyvault/resource-manager/Microsoft.KeyVault/KeyVault" \
  "openapi.json"

gen "ContainerService" \
  "containerservice/resource-manager/Microsoft.ContainerService/aks" \
  "managedClusters.json"

gen "Sql" \
  "sql/resource-manager/Microsoft.Sql/SQL" \
  "servers.json"

gen "MariaDB" \
  "mariadb/resource-manager/Microsoft.DBforMariaDB" \
  "Servers.json"

gen "MySQL" \
  "mysql/resource-manager/Microsoft.DBforMySQL/FlexibleServers" \
  "openapi.json"

gen "PostgreSQL" \
  "postgresql/resource-manager/Microsoft.DBforPostgreSQL" \
  "openapi.json"

gen "Authorization" \
  "authorization/resource-manager/Microsoft.Authorization/Authorization" \
  "authorization-RoleAssignmentsCalls.json"

gen "Insights" \
  "monitor/resource-manager/Microsoft.Insights/Insights" \
  "scheduledQueryRule_API.json"

gen "HDInsight" \
  "hdinsight/resource-manager/Microsoft.HDInsight/HDInsight" \
  "cluster.json"

# Microsoft.Commerce — preview spec only; use pinned URL directly
gen "Commerce" --url \
  "https://raw.githubusercontent.com/Azure/azure-rest-api-specs/main/specification/commerce/resource-manager/Microsoft.Commerce/Commerce/preview/2015-06-01-preview/commerce.json"

# ── Remove empty flat dirs left behind by the generator ──────────────────────
rmdir "${REPO_ROOT}/lib/azure_rest/api"    2>/dev/null || true
rmdir "${REPO_ROOT}/lib/azure_rest/models" 2>/dev/null || true
rmdir "${REPO_ROOT}/spec/api"             2>/dev/null || true
rmdir "${REPO_ROOT}/spec/models"          2>/dev/null || true

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
success "Generation complete."
echo ""
info "Files per namespace:"
find "${REPO_ROOT}/lib/azure_rest" -name "*.rb" \
  | grep -E "/(api|models)/" \
  | sed "s|${REPO_ROOT}/lib/azure_rest/||" \
  | awk -F'/' '{print $1}' \
  | sort | uniq -c | sort -rn \
  | awk '{printf "  %-20s %s files\n", $2, $1}'
echo ""
info "Total: $(find "${REPO_ROOT}/lib/azure_rest" -name "*.rb" | grep -E "/(api|models)/" | wc -l | tr -d ' ') files"
